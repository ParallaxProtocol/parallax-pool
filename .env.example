# Copy to .env and fill in the two required values. Everything else has sensible defaults.

# --- required -----------------------------------------------------------------------

# Your LAX address. The node mines to it (coinbase) and the pool tracks blocks for it.
POOL_ADDRESS=0x0000000000000000000000000000000000000000

# Password for the pool's PostgreSQL database (only used inside this compose project)
DB_PASSWORD=change-me

# --- payouts ------------------------------------------------------------------------

# direct: block rewards stay at POOL_ADDRESS, nothing is paid out. Use this to solo mine to
#         your own wallet; the node needs no key.
# pool:   rewards are shared between miners and paid from POOL_ADDRESS. The node must hold the
#         key for POOL_ADDRESS and unlock it (NODE_EXTRA_ARGS below, see README).
PAYOUT_MODE=direct

# PAYOUT_MODE=pool only
#PAYOUT_SCHEME=PPLNS            # PPLNS, PPLNSBF, PROP or SOLO
#PPLNS_FACTOR=2
#BLOCK_FINDER_PERCENT=5         # PPLNSBF bonus for the miner that found the block
#POOL_FEE_PERCENT=1
#POOL_FEE_ADDRESS=              # defaults to POOL_ADDRESS
#MINIMUM_PAYMENT=1              # LAX
#PAYMENT_INTERVAL=600           # seconds
#NODE_EXTRA_ARGS=--unlock 0xYourPoolAddress --password /home/parallax/.parallax/pool-password.txt --allow-insecure-unlock

# --- ports --------------------------------------------------------------------------

#STRATUM_PORT=4073
#API_PORT=4000
#NODE_P2P_PORT=32110

# --- tuning -------------------------------------------------------------------------

#STRATUM_DIFFICULTY=0.25        # starting share difficulty (1.0 = 2^32 hashes)
#VARDIFF_MIN=0.05
#VARDIFF_MAX=
#VARDIFF_TARGET_TIME=15         # seconds between shares per miner
#API_RATE_LIMIT=20              # requests per second per IP, 0 disables
#NODE_CACHE=1024                # node cache in MB
#LOG_LEVEL=info
